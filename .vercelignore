# Ignore node_modules (you may want to include it if you're deploying a monorepo with multiple projects)
node_modules

# Ignore test files and directories
test/
tests/
*.test.js
*.spec.js

# Ignore build files (if applicable)
build/
dist/

# Ignore local environment files
.env
.env.local
.env.development
.env.production

# Ignore logs and temporary files
logs/
*.log
*.tmp

# Ignore IDE/editor config files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore other unwanted files or directories
.cache/
*.lock
