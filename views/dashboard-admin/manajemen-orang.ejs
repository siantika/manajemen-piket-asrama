<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      /* Style tambahan untuk dashboard */
      body {
        font-family: Arial, sans-serif;
        background-color: #f8f9fa;
      }

      .sidebar {
        background-color: #007bff;
        min-height: 100vh;
      }

      .sidebar .nav-link {
        color: #ffffff;
      }

      .sidebar .nav-link.active {
        background-color: #0056b3;
        color: #ffffff;
      }

      .content {
        margin-left: 250px;
        padding: 20px;
      }

      .navbar {
        background-color: #0056b3;
        color: #ffffff;
      }

      .navbar .navbar-brand,
      .navbar .nav-link {
        color: #ffffff;
      }

      .navbar .nav-link:hover {
        color: #d1d1d1;
      }

      @media (max-width: 768px) {
        .content {
          margin-left: 0;
        }

        .sidebar {
          min-height: auto;
          padding-bottom: 10px;
        }
      }
    </style>
  </head>

  <body>
    <!-- Navbar Top -->
    <nav class="navbar navbar-expand-lg navbar-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">Admin Dashboard</a>
        <div class="collapse navbar-collapse justify-content-end">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="#">Logout</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="d-flex">
      <!-- Sidebar -->
      <nav class="sidebar d-flex flex-column p-3">
        <h4 class="text-white">Menu</h4>
        <ul class="nav nav-pills flex-column mb-auto">
          <li class="nav-item">
            <a href="#" class="nav-link">Manajemen Piket</a>
          </li>
          <li class="nav-item">
            <a href="#" class="nav-link">Manajemen Tempat</a>
          </li>
          <li class="nav-item">
            <a href="#" class="nav-link active" aria-current="page"
              >Manajemen Orang</a
            >
          </li>
          <li class="nav-item">
            <a href="#" class="nav-link">Rekap Piket</a>
          </li>
        </ul>
      </nav>

      <!-- Content -->
      <div class="container mt-4">
        <h1 class="mb-4"><%= title %></h1>
        <div class="row">
            <% orang.forEach(person => { %>
                <div class="col-md-4">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title text-center"> <strong> <%= person.memberName %> </strong></h5>
                            <p class="card-text"><strong>Peran:</strong> "Penghuni"</p>
                            <a href="/people/<%= person.id %>/edit" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form action="/members/delete/:<%= person.id %>" method="DELETE" style="display:inline;">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Hapus
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
        <a href="/people/new" class="btn btn-success mt-3">
            <i class="bi bi-person-plus"></i> Tambah Orang
        </a>
    </div>

    <!-- Bootstrap JS and Popper.js -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>
  </body>
</html>
