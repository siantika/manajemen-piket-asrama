<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <!-- Bootstrap CSS -->
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
</head>

<body class="admin-body">
    <!-- Navbar Top -->
    <%- include('navbar') %>
    <div class="admin-layout">
        <!-- Sidebar -->
        <%- include('sidebar') %>

        <!-- Content -->
        <main class="admin-content">
            <div class="admin-page-card">
            <h1>Historis Piket</h1>

            <!-- Filter Form -->
            <form id="filter-form" class="mb-4">
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label for="filter-nama">Nama:</label>
                        <select id="filter-nama" class="form-control">
                            <option value="">-- Select Nama --</option>
                            <!-- Options will be populated by JavaScript -->
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="filter-tempat">Tempat:</label>
                        <select id="filter-tempat" class="form-control">
                            <option value="">-- Select Tempat --</option>
                            <!-- Options will be populated by JavaScript -->
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <label for="filter-status">Status Piket:</label>
                        <select id="filter-status" class="form-control">
                            <option value="">-- Select Status --</option>
                            <!-- Options will be populated by JavaScript -->
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="filter-start-date">Start Date:</label>
                        <input type="date" id="filter-start-date" class="form-control">
                    </div>
                    <div class="form-group col-md-6">
                        <label for="filter-end-date">End Date:</label>
                        <input type="date" id="filter-end-date" class="form-control">
                    </div>
                </div>
                <button type="button" id="filter-btn" class="btn btn-primary btn-block">Filter</button>
            </form>

            <!-- Data Table -->
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Tanggal Piket</th>
                        <th>Nama</th>
                        <th>Tempat</th>
                        <th>Status Piket</th>
                    </tr>
                </thead>
                <tbody id="data-table-body">
                    <!-- Data will be populated here -->
                </tbody>
            </table>

            <!-- Pagination Controls -->
            <nav aria-label="Page navigation">
                <ul class="pagination" id="pagination-controls">
                    <!-- Pagination buttons will be added here -->
                </ul>
            </nav>
            </div>
        </main>
    </div>

    <!-- Bootstrap JS and Popper.js -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/authorize.js"></script>
    <script src="/js/historis.js"></script>
    <script src="/js/logout.js"></script>
</body>

</html>
