<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <!-- Bootstrap CSS -->
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
        }

        .sidebar {
            background-color: #007bff;
            min-height: 100vh;
        }

        .sidebar .nav-link {
            color: #ffffff;
        }

        .sidebar .nav-link.active {
            background-color: #0056b3;
            color: #ffffff;
        }

        .content {
            margin-left: 250px;
            padding: 20px;
        }

        .navbar {
            background-color: #0056b3;
            color: #ffffff;
        }

        .navbar .navbar-brand,
        .navbar .nav-link {
            color: #ffffff;
        }

        .navbar .nav-link:hover {
            color: #d1d1d1;
        }

        @media (max-width: 768px) {
            .content {
                margin-left: 0;
            }

            .sidebar {
                min-height: auto;
                padding-bottom: 10px;
            }
        }

        .input-tempat {
            margin-top: 10px;
            width: 100%;
        }

        .change-place-btn {
            margin-top: 10px;
        }

        .form-group {
            display: flex;
            align-items: center;
        }

        .form-group label {
            margin-right: 10px;
            font-weight: bold;
        }

        .text-display {
            font-weight: bold;
            color: #0056b3;
        }
    </style>
</head>

<body>
    <!-- Navbar Top -->
    <%- include('navbar') %>
        <div class="d-flex">
            <!-- Sidebar -->
            <%- include('sidebar') %>

                <!-- Content -->
                <!-- Content -->
                <main class="col-md-9 ml-sm-auto col-lg-10 px-4">
                    <h1>Historis Piket</h1>

                    <!-- Filter Form -->
                    <form id="filter-form">
                        <div class="form-group">
                            <label for="filter-nama">Nama:</label>
                            <select id="filter-nama" class="form-control">
                                <option value="">-- Select Nama --</option>
                                <!-- Options will be populated by JavaScript -->
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="filter-tempat">Tempat:</label>
                            <select id="filter-tempat" class="form-control">
                                <option value="">-- Select Tempat --</option>
                                <!-- Options will be populated by JavaScript -->
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="filter-status">Status Piket:</label>
                            <select id="filter-status" class="form-control">
                                <option value="">-- Select Status --</option>
                                <!-- Options will be populated by JavaScript -->
                            </select>
                        </div>
                        <button type="button" id="filter-btn" class="btn btn-primary">Filter</button>
                    </form>

                    <!-- Data Table -->
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Tanggal Piket</th>
                                <th>Nama</th>
                                <th>Tempat</th>
                                <th>Status Piket</th>
                            </tr>
                        </thead>
                        <tbody id="data-table-body">
                            <!-- Data will be populated here -->
                        </tbody>
                    </table>

                    <!-- Pagination Controls -->
                    <nav aria-label="Page navigation">
                        <ul class="pagination" id="pagination-controls">
                            <!-- Pagination buttons will be added here -->
                        </ul>
                    </nav>
                </main>

        </div>

        <!-- Bootstrap JS and Popper.js -->
        <script src="/js/jquery.min.js"></script>
        <script src="/js/popper.min.js"></script>
        <script src="/js/bootstrap.bundle.min.js"></script>
        <script src="/js/historis.js"></script>
        <script src="/js/logout.js"></script>
</body>

</html>