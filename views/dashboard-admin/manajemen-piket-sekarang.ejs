<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <!-- Bootstrap CSS -->
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
        }

        .sidebar {
            background-color: #007bff;
            min-height: 100vh;
        }

        .sidebar .nav-link {
            color: #ffffff;
        }

        .sidebar .nav-link.active {
            background-color: #0056b3;
            color: #ffffff;
        }

        .content {
            margin-left: 250px;
            padding: 20px;
        }

        .navbar {
            background-color: #0056b3;
            color: #ffffff;
        }

        .navbar .navbar-brand,
        .navbar .nav-link {
            color: #ffffff;
        }

        .navbar .nav-link:hover {
            color: #d1d1d1;
        }

        @media (max-width: 768px) {
            .content {
                margin-left: 0;
            }

            .sidebar {
                min-height: auto;
                padding-bottom: 10px;
            }
        }

        .input-tempat {
            margin-top: 10px;
            width: 100%;
        }

        .change-place-btn {
            margin-top: 10px;
        }

        .form-group {
            display: flex;
            align-items: center;
        }

        .form-group label {
            margin-right: 10px;
            font-weight: bold;
        }

        .text-display {
            font-weight: bold;
            color: #0056b3;
        }
    </style>
</head>

<body>
    <!-- Navbar Top -->
    <%- include('navbar') %>
    <div class="d-flex">
        <!-- Sidebar -->
        <%- include('sidebar') %>

        <!-- Content -->
        <main class="col-md-9 ml-sm-auto col-lg-10 px-4">
            <h1>Manajemen Piket</h1>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Tanggal Piket</th>
                        <th>Nama</th>
                        <th>Tempat</th>
                        <th>Status Piket</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (piket && piket.length > 0) { %>
                        <% piket.forEach(function(item, index) { %>
                            <tr id="row-<%= index %>">
                                <td><%= item.tanggalPiket %></td>
                                <td><%= item.nama %></td>
                                <td>
                                    <div class="form-group">
                                        <strong class="text-display" id="tempat-<%= index %>"><%= item.tempat %></strong>
                                        <select class="form-select input-tempat d-none" id="dropdown-<%= index %>">
                                            <% tempatPiket.forEach(function(tempat) { %>
                                                <option value="<%= tempat.namaTempat %>" <%= tempat.namaTempat === item.tempat ? 'selected' : '' %>><%= tempat.namaTempat %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-primary change-place-btn" data-index="<%= index %>" data-id="<%= item.id %>">
                                        <i class="bi bi-pencil"></i> Ubah Tempat
                                    </button>
                                </td>
                                <td id="status-<%= index %>"><%= item.statusPiket %></td>
                                <td>
                                    <button type="button" class="btn btn-warning btn-sm edit-btn" data-index="<%= index %>" data-id="<%= item.id %>">
                                        <i class="bi bi-pencil"></i> Validasi
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="text-center">Tidak ada data piket</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            <div class="row">
                <div  class="col-12 col-md-4 d-flex justify-content-center mb-3 mb-md-0">
                    <button id="buatJadwalBtn" class="btn btn-primary w-100">Buat Jadwal</button>
                </div>
                <div class="col-12 col-md-4 d-flex justify-content-center mb-3 mb-md-0">
                    <button id="rekapBtn" class="btn btn-secondary w-100">Rekap</button>
                </div>
                <div class="col-12 col-md-4 d-flex justify-content-center">
                    <button id="validasiAllBtn" class="btn btn-success w-100">Lakukan Validasi</button>
                </div>
            </div>
                    <!-- Date Picker (initially hidden) -->
        <div id="datePickerContainer" class="mt-3 d-none">
            <label for="scheduleDate">Pilih Tanggal:</label>
            <input type="date" id="scheduleDate" class="form-control">
            <button id="submitDateBtn" class="btn btn-primary mt-2">Submit Tanggal</button>
        </div>
        </main>
    </div>



    <!-- Bootstrap JS and Popper.js -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/authorize.js"></script>
    <script src="/js/manajemen-piket-sekarang.js"></script>
    <script src="/js/logout.js"></script>
</body>

</html>
