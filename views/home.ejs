<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Jadwal Piket Asrama Viyata Tirtagangga</title>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
</head>
<body class="home-page">
    <!-- navbar -->
    <nav class="navbar navbar-light home-navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand d-flex align-items-center" href="#">
                <img src="/img/amvt-bg.png" width="60" height="60" class="d-inline-block align-top img-fluid" alt="Your Logo" />
                <span class="ml-2">Asrama Viyata Tirtagangga</span>
            </a>
            <a href="/login-admin">
                <span class="navbar-text text-white">Login as admin</span>
            </a>
        </div>
    </nav>

    <main class="home-main">
        <div class="hero-section py-5">
            <div class="container text-center">
                <h1 class="display-4">Jadwal Piket Penghuni Asrama</h1>
            </div>
        </div>

    <!-- Filter -->
        <div class="container section-container">
        <div class="panel-card mb-4">
            <div class="row mb-0">
                <div class="col-md-3 mb-2 mb-md-0">
                    <select id="filter-nama" class="form-control">
                        <option value="">-- Filter Nama --</option>
                    </select>
                </div>
                <div class="col-md-3 mb-2 mb-md-0">
                    <select id="filter-tempat" class="form-control">
                        <option value="">-- Filter Tempat --</option>
                    </select>
                </div>
                <div class="col-md-3 mb-2 mb-md-0">
                    <select id="filter-status" class="form-control">
                        <option value="">-- Filter Status --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button id="filter-btn" class="btn btn-primary w-100">Filter</button>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="panel-card">
            <table class="table table-striped mb-3">
                <thead>
                    <tr>
                        <th>Tanggal Piket</th>
                        <th>Nama</th>
                        <th>Tempat</th>
                        <th>Status Piket</th>
                    </tr>
                </thead>
                <tbody id="table-body">
                    <!-- Data rows will be dynamically inserted here -->
                </tbody>
            </table>

            <!-- Pagination Controls -->
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center mb-0" id="pagination-controls">
                    <!-- Pagination links will be dynamically inserted here -->
                </ul>
            </nav>
        </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="home-footer">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-center">
                    <h5>Contact Us</h5>
                    <p>Email: -</p>
                    <p>Phone: -</p>
                </div>
                <div class="col-md-6 text-center">
                    <h5>Follow Us</h5>
                    <ul class="list-unstyled">
                        <li><a href="https://www.facebook.com/asramabaliviyata/">Facebook</a></li>
                        <li><a href="https://www.instagram.com/asramabaliviyata/">Instagram</a></li>
                    </ul>
                </div>
            </div>
            <div class="text-center mt-3">
                <p>&copy; 2024 Asrama Viyata Tirtagangga. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="/js/home.js"></script>
</body>
</html>
